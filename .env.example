# GEMINI_API_KEY: Optional fallback for AI API calls if Ollama is not yet started.
# AI Studio automatically injects this at runtime from user secrets if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OLLAMA CONFIGURATION (For local open-weight AI on Windows/Mac/Linux)
# Ollama's local server URL (Default: http://localhost:11434)
OLLAMA_HOST="http://localhost:11434"

# Target local model (Default: qwen3:0.6b, also supports llama3.2, mistral, phi3)
OLLAMA_MODEL="qwen3:0.6b"

# GITHUB_TOKEN (Optional: Personal Access Token for GitHub API)
# Unauthenticated requests are limited to 60 req/hr. Adding a token boosts to 5,000 req/hr.
GITHUB_TOKEN=""
